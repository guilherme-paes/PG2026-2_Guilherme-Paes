src/Lista2/exercicio5/exercicio5.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\exercicio5.dir\build.make CMakeFiles/exercicio5.dir/src/Lista2/exercicio5/exercicio5.cpp.s
.PHONY : src/Lista2/exercicio5/exercicio5.cpp.s

